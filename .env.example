VITE_SUPABASE_ANON_KEY=chave-local-dev
# Opcional: vídeo de fundo do login (URL pública .mp4). Sem ela, o login usa só a imagem.
# Não é exibido com prefers-reduced-motion.
VITE_LOGIN_VIDEO_URL=
